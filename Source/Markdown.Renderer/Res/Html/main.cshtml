@using RazorLight
@inherits TemplatePage<Markdown.Renderer.Res.Model.MainModel>

<!DOCTYPE html>

<html>
<head>
    <title>@Model.Title</title>
    <meta charset="utf-8">
    <meta name="description" content="@Model.Description">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="@Model.CssLink">
</head>
<body>
<header class="site-header">
    <button class="navigation-toggle" id="navigation-toggle" type="button" aria-expanded="true" aria-controls="site-navigation">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <rect x="2.5" y="3.5" width="15" height="13" rx="2"></rect>
            <path d="M8 4v12M5 7h1M5 10h1M5 13h1"></path>
        </svg>
        <span>Dokumentation</span>
    </button>
</header>
<div class="site-layout" id="site-layout">
    <aside class="site-sidebar" id="site-navigation" aria-label="Sitemap">
        <nav aria-label="Dokumentationsseiten">
            <ul class="site-nav-list">
                @foreach (var item in Model.NavigationItems)
                {
                    <li class="site-nav-item" style="--depth: @item.Depth">
                        <a class="site-nav-link @(item.IsCurrent ? "is-current" : string.Empty)" href="@item.Url" aria-current="@(item.IsCurrent ? "page" : "false")">@item.Title</a>
                    </li>
                }
            </ul>
        </nav>
    </aside>
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" tabindex="-1" aria-label="Navigation schließen"></button>
    <main class="site-main">
        @Raw(@Model.RenderedMarkdown)
        @if (!string.IsNullOrEmpty(Model.EditPageLink))
        {
            <hr />
            <a href="@Model.EditPageLink">✎ Edit Page</a>
        }
    </main>
</div>
<script>
(() => {
    const layout = document.getElementById("site-layout");
    const toggle = document.getElementById("navigation-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    const navigation = document.getElementById("site-navigation");
    const breakpoint = window.matchMedia("(max-width: 760px)");
    let isOpen = !breakpoint.matches;

    const setOpen = (open) => {
        isOpen = open;
        layout.classList.toggle("sidebar-open", open && breakpoint.matches);
        layout.classList.toggle("sidebar-collapsed", !open && !breakpoint.matches);
        toggle.setAttribute("aria-expanded", String(open));

        if (open && breakpoint.matches) {
            navigation.querySelector("a")?.focus();
        } else if (!open && navigation.contains(document.activeElement)) {
            toggle.focus();
        }
    };

    setOpen(isOpen);
    toggle.addEventListener("click", () => setOpen(!isOpen));
    backdrop.addEventListener("click", () => setOpen(false));
    navigation.addEventListener("click", (event) => {
        if (breakpoint.matches && event.target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
        if (breakpoint.matches && isOpen && event.key === "Escape") setOpen(false);
    });
    breakpoint.addEventListener("change", (event) => setOpen(!event.matches));
})();
</script>
</body>
</html>
